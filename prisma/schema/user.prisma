model User {
    id           String       @id @default(uuid())
    name         String
    email        String       @unique
    password     String
    role         Role
    activeStatus ActiveStatus @default(ACTIVE)
    createdAt    DateTime     @default(now())
    updatedAt    DateTime     @updatedAt

    properties     Property[]
    rentalRequests RentalRequest[]
    reviews        Review[]

    @@map("users")
}
